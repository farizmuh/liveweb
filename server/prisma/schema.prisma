datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  REFEREE
}

enum BoFormat {
  BO1
  BO3
  BO5
  BO7
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  name            String
  role            Role     @default(REFEREE)
  assignedMatches Match[]  @relation("AssignedReferee")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  shortName String
  logoUrl   String?
  colorHex  String?  @default("#2563eb")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsA Match[] @relation("TeamA")
  matchesAsB Match[] @relation("TeamB")
}

model Match {
  id                 String    @id @default(uuid())
  matchKey           String    @unique // e.g. match-8f3a9b untuk OBS /overlay?key=match-8f3a9b
  courtName          String    @default("Court 1") // e.g. "Meja 1 / Court 1"
  tournamentName     String    @default("MPL INDONESIA")
  roundName          String    @default("REGULAR SEASON")
  format             BoFormat  @default(BO3)

  teamAId            String?
  teamA              Team?     @relation("TeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamAName          String    @default("BLUE TEAM")
  teamAShort         String    @default("BLUE")
  teamALogo          String?
  scoreA             Int       @default(0)

  teamBId            String?
  teamB              Team?     @relation("TeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  teamBName          String    @default("RED TEAM")
  teamBShort         String    @default("RED")
  teamBLogo          String?
  scoreB             Int       @default(0)

  assignedRefereeId  String?
  assignedReferee    User?     @relation("AssignedReferee", fields: [assignedRefereeId], references: [id], onDelete: SetNull)

  isActive           Boolean   @default(true)
  isCompleted        Boolean   @default(false)
  winnerTeam         String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Sponsor {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id          String   @id @default("global_config")
  tickerText  String   @default("Welcome to the Tournament! • Subscribe & Follow our Social Media")
  showTicker  Boolean  @default(true)
  showSponsor Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
